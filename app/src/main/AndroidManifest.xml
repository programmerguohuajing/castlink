<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- v0.3.5：加回。NetUtil.isWifiConnected 用 ConnectivityManager 判 Wi-Fi 连通性 -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- v0.3.5：投放的 APK 文件调系统安装器 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />

    <application
        android:name=".CastLinkApp"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/Theme.CastLink"
        android:allowBackup="true">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.ControlActivity"
            android:exported="false"
            android:label="@string/title_control" />

        <activity
            android:name=".ui.StandbyActivity"
            android:exported="false"
            android:label="@string/title_standby" />

        <activity
            android:name=".ui.SettingsActivity"
            android:exported="false"
            android:label="@string/title_settings" />

        <activity
            android:name=".ui.PlayerActivity"
            android:exported="false"
            android:label="@string/player_title"
            android:screenOrientation="landscape" />

        <!-- v0.3.10：原生协议投屏全屏播放页 -->
        <activity
            android:name=".ui.StreamPlayerActivity"
            android:exported="false"
            android:screenOrientation="landscape" />

        <service
            android:name=".airplay.AirPlayService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <activity
            android:name=".sender.SenderActivity"
            android:exported="false"
            android:label="@string/title_sender" />

        <!-- 发送端前台服务：API 29+ 必须声明 mediaProjection 类型；
             低版本系统会忽略该未知属性，Service 内另做版本判断。 -->
        <service
            android:name=".sender.SenderService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <!-- v0.3.5：投放文件共享（APK 安装 / 系统查看器），不引入 AndroidX FileProvider -->
        <provider
            android:name=".util.FileShareProvider"
            android:authorities="com.castlink.receiver.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true" />

    </application>

</manifest>
