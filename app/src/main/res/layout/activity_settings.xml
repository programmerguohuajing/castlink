<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_nebula">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- 语言 -->
        <LinearLayout
            android:id="@+id/row_language"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="12dp"
            android:paddingBottom="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/setting_language_title"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tv_lang_summary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- 本机能力卡 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@color/deep_blue"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/device_capability_title"
                android:textColor="@color/white"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/device_capability_desc"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 画质单选 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/setting_quality_title"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/nebula_cyan" />

        <RadioGroup
            android:id="@+id/rg_quality"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/rb_quality_auto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/quality_auto" />

            <RadioButton
                android:id="@+id/rb_quality_flagship"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/quality_flagship" />

            <RadioButton
                android:id="@+id/rb_quality_1080p"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/quality_1080p" />

            <RadioButton
                android:id="@+id/rb_quality_720p"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/quality_720p" />
        </RadioGroup>

        <!-- 开关项 -->
        <Switch
            android:focusable="true"
            android:id="@+id/sw_prefer_5g"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/setting_prefer_5g" />

        <Switch
            android:focusable="true"
            android:id="@+id/sw_legacy_mode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/setting_legacy_mode" />

        <!-- 设备名 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/setting_device_name"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/nebula_cyan" />

        <EditText
            android:id="@+id/et_device_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:hint="@string/device_name_hint"
            android:inputType="text"
            android:maxLines="1" />

        <Button
            android:id="@+id/btn_save_device_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_neon_btn"
            android:textColor="@color/white"
            android:text="@string/btn_save" />

        <!-- v0.1.1 (issue #1)：AirPlay 配对 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/setting_airplay_title"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/nebula_cyan" />

        <Switch
            android:focusable="true"
            android:id="@+id/sw_skip_pair_verify"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/setting_skip_pair_verify"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/setting_skip_pair_verify_desc"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btn_clear_pairings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/btn_clear_pairings" />

        <!-- v0.3.12：在线更新 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/setting_update_title"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/nebula_cyan" />

        <TextView
            android:id="@+id/tv_update_version"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/update_source"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/update_mirror_label"
            android:textSize="14sp" />

        <Spinner
            android:id="@+id/sp_update_mirror"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_check_update"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btn_check_update" />

            <Button
                android:id="@+id/btn_save_update_cfg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_neon_btn"
                android:textColor="@color/white"
                android:text="@string/btn_save" />
        </LinearLayout>

        <Switch
            android:focusable="true"
            android:id="@+id/sw_auto_update"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/setting_auto_update" />
    </LinearLayout>
</ScrollView>
