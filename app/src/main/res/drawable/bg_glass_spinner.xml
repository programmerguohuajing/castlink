<?xml version="1.0" encoding="utf-8"?>
<!-- 下拉框背景 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#1A284A" />
                    <stroke
                        android:width="2dp"
                        android:color="@color/nebula_cyan" />
                    <corners android:radius="12dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#141E38" />
                    <stroke
                        android:width="1dp"
                        android:color="#2A3D63" />
                    <corners android:radius="12dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
