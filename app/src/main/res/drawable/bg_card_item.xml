<?xml version="1.0" encoding="utf-8"?>
<!-- 列表项卡片：ListView 用遥控器选中/聚焦时显示强调色描边（卡片不透明，系统自带的选中高亮会被盖住，必须自己画） -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/nebula_glass" />
                    <corners android:radius="20dp" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/nebula_accent_soft" />
                    <stroke android:width="3dp" android:color="@color/nebula_cyan" />
                    <corners android:radius="20dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/nebula_glass" />
                    <corners android:radius="20dp" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/nebula_accent_soft" />
                    <stroke android:width="3dp" android:color="@color/nebula_cyan" />
                    <corners android:radius="20dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/nebula_fill_strong" />
            <stroke android:width="1dp" android:color="@color/nebula_glass_border" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/nebula_glass" />
            <stroke android:width="1dp" android:color="@color/nebula_glass_border" />
            <corners android:radius="20dp" />
        </shape>
    </item>
</selector>
