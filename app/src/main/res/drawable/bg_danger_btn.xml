<?xml version="1.0" encoding="utf-8"?>
<!-- 危险操作按钮 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
            <solid android:color="@color/nebula_danger_soft" />
            <stroke android:width="3dp" android:color="@color/nebula_red" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
            <solid android:color="@color/nebula_danger_border" />
            <stroke android:width="1dp" android:color="@color/nebula_red" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
            <solid android:color="@color/nebula_danger_soft" />
            <stroke android:width="1dp" android:color="@color/nebula_danger_border" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
