<?xml version="1.0" encoding="utf-8"?>
<!-- 次按钮：浅底描边，TV 焦点高亮 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
            <solid android:color="@color/nebula_fill_strong" />
            <stroke android:width="1dp" android:color="@color/nebula_glass_border" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
            <solid android:color="@color/nebula_accent_soft" />
            <stroke android:width="3dp" android:color="@color/nebula_cyan" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
            <solid android:color="@color/nebula_fill" />
            <stroke android:width="1dp" android:color="@color/nebula_glass_border" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</selector>
