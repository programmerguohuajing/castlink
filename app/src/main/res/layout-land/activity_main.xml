<?xml version="1.0" encoding="utf-8"?>
<!-- NEBULA 主页：横屏（侧边 Tab） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_nebula"
    android:orientation="horizontal">

    <!-- 侧边 Tab -->
    <LinearLayout
        android:layout_width="120dp"
        android:layout_height="match_parent"
        android:background="@color/nebula_nav"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="CastLink"
            android:textColor="@color/nebula_text"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/tab_btn_cast"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_tab"
            android:text="@string/tab_cast"
            android:textColor="@color/nebula_cyan" />

        <Button
            android:id="@+id/tab_btn_media"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_tab"
            android:text="@string/tab_media"
            android:textColor="@color/nebula_text_2ry" />

        <Button
            android:id="@+id/tab_btn_mine"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_tab"
            android:text="@string/tab_mine"
            android:textColor="@color/nebula_text_2ry" />
    </LinearLayout>

    <!-- 内容 -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tv_wifi_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/nebula_text_2ry"
            android:textSize="13sp" />

        <ViewFlipper
            android:id="@+id/flipper"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="8dp">

            <!-- 第 0 页：投屏 -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <Button
                            android:id="@+id/btn_start_cast"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:background="@drawable/bg_neon_btn"
                            android:text="@string/btn_start_cast"
                            android:textColor="@color/nebula_on_accent"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <Button
                            android:id="@+id/btn_start_sender"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:layout_marginTop="10dp"
                            android:background="@drawable/bg_glass_btn"
                            android:text="@string/btn_start_sender"
                            android:textColor="@color/nebula_cyan"
                            android:textSize="16sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/devices_title"
                            android:textColor="@color/nebula_text_3ry"
                            android:textSize="13sp" />

                        <ListView
                            android:listSelector="@android:color/transparent"
                            android:id="@+id/lv_devices"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginTop="8dp"
                            android:divider="@android:color/transparent"
                            android:dividerHeight="8dp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/empty_view"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/empty_title"
                        android:textColor="@color/nebula_text"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btn_manual_ip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_glass_btn"
                        android:text="@string/btn_manual_ip"
                        android:textColor="@color/nebula_cyan" />
                </LinearLayout>
            </FrameLayout>

            <!-- 第 1 页：媒体 -->
            <ListView
                android:listSelector="@android:color/transparent"
                android:id="@+id/lv_media_files"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:divider="@android:color/transparent"
                android:dividerHeight="8dp" />

            <!-- 第 2 页：我的 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:padding="8dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/mine_history_title"
                        android:textColor="@color/nebula_text"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/mine_history_empty"
                        android:textColor="@color/nebula_text_3ry"
                        android:textSize="14sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <Button
                        android:id="@+id/btn_open_settings"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:background="@drawable/bg_glass_btn"
                        android:text="@string/btn_settings"
                        android:textColor="@color/nebula_cyan" />

                    <Button
                        android:id="@+id/btn_help"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_glass_btn"
                        android:text="@string/btn_help"
                        android:textColor="@color/nebula_cyan" />
                </LinearLayout>
            </LinearLayout>
        </ViewFlipper>
    </LinearLayout>
</LinearLayout>
